# WattWise Configuration

# Set to true to run instant offline demo mode without calling any local Ollama models:
DEMO_MODE=true

# Local Ollama endpoint configuration:
OLLAMA_BASE_URL=http://localhost:11434

# Ollama Models:
TEXT_MODEL=phi3:latest
VISION_MODEL=llava

# Flask server port (default 5000):
PORT=5000
FLASK_DEBUG=0
